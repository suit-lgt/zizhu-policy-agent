# 端口固定规划（宿主机）：8000 学生／公共，8001 教师审核，8002 管理，8003 接口
# 修改端口需同时改 docker-compose.yml、app/main.py 的 ENTRY_PORT_ROLES 与 app/static/login.html 的角色跳转
# 详见 docs/部署与端口设计.md

# 可选：覆盖容器内库路径，默认已在镜像与 compose 中设定
# APP_DB=/app/data/app.db
# POLICY_DB=/app/data/staging/policies.db

# AI 三态 Provider：offline（默认，不联网）／online（OpenAI 兼容）／mock（自测）
FUND_LLM_MODE=offline
# online 模式才需要：端点不带 /chat/completions 后缀
# FUND_LLM_BASE=https://api.example.com/v1
# FUND_LLM_KEY=
# FUND_LLM_MODEL=
# FUND_LLM_TIMEOUT=20

# 统一身份：dev（请求头演示态）／cas（未配置时接口返回 501，不做假登录）
AUTH_MODE=dev
# CAS_BASE=

# 访问日志级别：INFO 记方法/路径/状态/耗时（查询串已脱敏）；WARNING 关闭
LOG_LEVEL=INFO
